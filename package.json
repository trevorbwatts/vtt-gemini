{
  "name": "dungeon-master-desktop-vtt",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run electron:start\"",
    "clean": "rm -rf dist dist-electron"
  },
